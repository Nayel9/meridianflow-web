# ============================================================================
# Meridian Flow — environment variables
# ============================================================================
# Copy this file to `.env.local` (gitignored) for local dev. Set the same
# values in the Vercel dashboard for production.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://meridianflow.dev

# --- Server-side (consumed by /api/contact, NEVER prefixed NEXT_PUBLIC_) ---
# Brevo — transactional email (owner notification + client confirmation)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER=meridianflow@pennarstudio.fr
BREVO_SENDER_NAME=Meridian Flow
OWNER_EMAIL=meridianflow@pennarstudio.fr

# Notion — lead storage with auto-mapped schema
# DB created via MCP on 2026-05-28 — title "Leads Meridian Flow"
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ID=d88f45a516464595966782a193d54dc0
